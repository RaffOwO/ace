#include <dt-bindings/zmk/matrix_transform.h>
#include "tessera-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &tessera_layout;
    };

    tessera_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <13>;
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)
            RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)
            RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12)
        >;
    };
};
