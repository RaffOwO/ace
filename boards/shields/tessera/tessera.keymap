/*
 * Tessera Taipo-style split keymap.
 *
 * Global key position order:
 *   Left card:  L0..L12  = positions 0..12
 *   Right card: R0..R12  = positions 13..25
 *
 * The keyboard is a real ZMK split with one Bluetooth host connection, but
 * all chords are defined as side-local left/right combo pairs.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NUM 1
#define SYM 2
#define NAV 3
#define MOUSE 4
#define FUNC 5
#define SYS 6
#define MEDIA 7

#define COMBO_TIMEOUT 70
#define COMBO_LAYERS BASE
#define STICKY_TIMEOUT 500

#define L0 0
#define L1 1
#define L2 2
#define L3 3
#define L4 4
#define L5 5
#define L6 6
#define L7 7
#define L8 8
#define L9 9
#define L10 10
#define L11 11
#define L12 12

#define R0 13
#define R1 14
#define R2 15
#define R3 16
#define R4 17
#define R5 18
#define R6 19
#define R7 20
#define R8 21
#define R9 22
#define R10 23
#define R11 24
#define R12 25

&sk {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
};

/ {
    behaviors {
        /*
         * K0 behavior:
         *   tap  -> BASE / panic reset
         *   hold -> SYS
         *
         * tap-preferred is important because K0 is also used in combos:
         *   K0 + K12 -> NAV
         *   K0 + K11 -> MOUSE
         *   K0 + K10 -> FUNC
         *
         * Do NOT use raw &mo SYS on K0, because it activates SYS immediately
         * and steals the combo context.
         */
        k0_sys: k0_sys {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&to>;
        };
    };

    #define TCOMBO(NAME, BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
    combo_l_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <BINDINGS>; \
        key-positions = <LEFT_KEYPOS>; \
        layers = <COMBO_LAYERS>; \
        slow-release; \
    }; \
    combo_r_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <BINDINGS>; \
        key-positions = <RIGHT_KEYPOS>; \
        layers = <COMBO_LAYERS>; \
        slow-release; \
    };

    #define TCOMBO_ON(NAME, BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS, LAYERS) \
    combo_l_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <BINDINGS>; \
        key-positions = <LEFT_KEYPOS>; \
        layers = <LAYERS>; \
        slow-release; \
    }; \
    combo_r_##NAME { \
        timeout-ms = <COMBO_TIMEOUT>; \
        bindings = <BINDINGS>; \
        key-positions = <RIGHT_KEYPOS>; \
        layers = <LAYERS>; \
        slow-release; \
    };

    combos {
        compatible = "zmk,combos";

        TCOMBO(tab, &kp TAB, L3 L2 L1, R3 R2 R1)
        TCOMBO(enter, &kp ENTER, L7 L6 L5, R7 R6 R5)
        TCOMBO(esc, &kp ESC, L6 L5 L4, R6 R5 R4)

        TCOMBO(access_sym, &mo SYM, L11 L12, R11 R12)
        TCOMBO(access_nav, &to NAV, L0 L12, R0 R12)
        TCOMBO(access_mouse, &to MOUSE, L0 L11, R0 R11)
        TCOMBO(access_func, &to FUNC, L0 L10, R0 R10)

        TCOMBO_ON(alpha_d, &kp D, L3 L7, R3 R7, BASE)
        TCOMBO_ON(alpha_l, &kp L, L2 L6, R2 R6, BASE)
        TCOMBO_ON(alpha_b, &kp B, L1 L5, R1 R5, BASE)
        TCOMBO_ON(alpha_r, &kp R, L2 L3, R2 R3, BASE)
        TCOMBO_ON(alpha_c, &kp C, L1 L2, R1 R2, BASE)
        TCOMBO_ON(alpha_h, &kp H, L6 L7, R6 R7, BASE)
        TCOMBO_ON(alpha_u, &kp U, L5 L6, R5 R6, BASE)
        TCOMBO_ON(alpha_m, &kp M, L1 L3, R1 R3, BASE)
        TCOMBO_ON(alpha_w, &kp W, L5 L7, R5 R7, BASE)
        TCOMBO_ON(alpha_p, &kp P, L4 L5, R4 R5, BASE)
        TCOMBO_ON(alpha_y, &kp Y, L2 L7, R2 R7, BASE)
        TCOMBO_ON(alpha_g, &kp G, L2 L5, R2 R5, BASE)
        TCOMBO_ON(alpha_f, &kp F, L3 L6, R3 R6, BASE)
        TCOMBO_ON(alpha_v, &kp V, L1 L4, R1 R4, BASE)
        TCOMBO_ON(alpha_k, &kp K, L3 L5, R3 R5, BASE)
        TCOMBO_ON(alpha_z, &kp Z, L3 L4, R3 R4, BASE)
        TCOMBO_ON(alpha_x, &kp X, L1 L7, R1 R7, BASE)
        TCOMBO_ON(alpha_j, &kp J, L4 L7, R4 R7, BASE)
        TCOMBO_ON(alpha_q, &kp Q, L1 L6, R1 R6, BASE)

        TCOMBO_ON(num_4, &kp N4, L3 L7, R3 R7, NUM)
        TCOMBO_ON(num_5, &kp N5, L2 L6, R2 R6, NUM)
        TCOMBO_ON(num_6, &kp N6, L1 L5, R1 R5, NUM)
        TCOMBO_ON(num_plus, &kp PLUS, L2 L3, R2 R3, NUM)
        TCOMBO_ON(num_minus, &kp MINUS, L1 L2, R1 R2, NUM)
        TCOMBO_ON(num_star, &kp STAR, L6 L7, R6 R7, NUM)
        TCOMBO_ON(num_slash, &kp FSLH, L5 L6, R5 R6, NUM)
        TCOMBO_ON(num_comma, &kp COMMA, L1 L4, R1 R4, NUM)
        TCOMBO_ON(num_dot, &kp DOT, L4 L5, R4 R5, NUM)
        TCOMBO_ON(num_semi, &kp SEMI, L3 L4, R3 R4, NUM)
        TCOMBO_ON(num_colon, &kp COLON, L4 L7, R4 R7, NUM)
        TCOMBO_ON(num_equal, &kp EQUAL, L1 L3, R1 R3, NUM)
        TCOMBO_ON(num_percent, &kp PRCNT, L2 L7, R2 R7, NUM)
        TCOMBO_ON(num_caret, &kp CARET, L3 L6, R3 R6, NUM)
        TCOMBO_ON(num_lt, &kp LT, L2 L5, R2 R5, NUM)
        TCOMBO_ON(num_gt, &kp GT, L1 L6, R1 R6, NUM)
        TCOMBO_ON(num_lpar, &kp LPAR, L1 L7, R1 R7, NUM)
        TCOMBO_ON(num_rpar, &kp RPAR, L3 L5, R3 R5, NUM)

        TCOMBO_ON(sym_semi, &kp SEMI, L2 L6, R2 R6, SYM)
        TCOMBO_ON(sym_slash, &kp FSLH, L2 L7, R2 R7, SYM)
        TCOMBO_ON(sym_bslash, &kp BSLH, L3 L6, R3 R6, SYM)
        TCOMBO_ON(sym_lt, &kp LT, L2 L3, R2 R3, SYM)
        TCOMBO_ON(sym_gt, &kp GT, L1 L2, R1 R2, SYM)
        TCOMBO_ON(sym_lbrace, &kp LBRC, L6 L7, R6 R7, SYM)
        TCOMBO_ON(sym_rbrace, &kp RBRC, L5 L6, R5 R6, SYM)
        TCOMBO_ON(sym_dquote, &kp DQT, L4 L5, R4 R5, SYM)
        TCOMBO_ON(sym_grave, &kp GRAVE, L1 L4, R1 R4, SYM)
        TCOMBO_ON(sym_under, &kp UNDER, L5 L7, R5 R7, SYM)
        TCOMBO_ON(sym_pipe, &kp PIPE, L3 L7, R3 R7, SYM)
        TCOMBO_ON(sym_amp, &kp AMPS, L2 L5, R2 R5, SYM)
        TCOMBO_ON(sym_at, &kp AT, L1 L5, R1 R5, SYM)
        TCOMBO_ON(sym_qmark, &kp QMARK, L4 L7, R4 R7, SYM)
        TCOMBO_ON(sym_exclaim, &kp EXCL, L3 L4, R3 R4, SYM)
        TCOMBO_ON(sym_hash, &kp HASH, L1 L7, R1 R7, SYM)
        TCOMBO_ON(sym_dollar, &kp DLLR, L3 L5, R3 R5, SYM)
        TCOMBO_ON(sym_tilde, &kp TILDE, L1 L3, R1 R3, SYM)

        TCOMBO_ON(func_f7, &kp F7, L3 L7, R3 R7, FUNC)
        TCOMBO_ON(func_f8, &kp F8, L2 L6, R2 R6, FUNC)
        TCOMBO_ON(func_f9, &kp F9, L1 L5, R1 R5, FUNC)
        TCOMBO_ON(func_f10, &kp F10, L2 L3, R2 R3, FUNC)
        TCOMBO_ON(func_f11, &kp F11, L1 L2, R1 R2, FUNC)

        TCOMBO_ON(mod_ctrl, &sk LEFT_CONTROL, L8, R8, BASE)
        TCOMBO_ON(mod_gui, &sk LEFT_GUI, L9, R9, BASE)
        TCOMBO_ON(mod_alt, &sk LEFT_ALT, L10, R10, BASE)

        TCOMBO_ON(mouse_btn4, &mkp MB4, L4 L1, R4 R1, MOUSE)
        TCOMBO_ON(mouse_btn5, &mkp MB5, L4 L3, R4 R3, MOUSE)
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &k0_sys SYS BASE &kp S       &kp N       &kp I
                &kp A            &kp O       &kp T       &kp E
                &trans            &trans       &trans       &lt NUM BSPC &mt LEFT_SHIFT SPACE

                &k0_sys SYS BASE &kp S       &kp N       &kp I
                &kp A            &kp O       &kp T       &kp E
                &trans            &trans       &trans       &lt NUM BSPC &mt LEFT_SHIFT SPACE
            >;
        };

        num_layer {
            bindings = <
                &to BASE        &kp N9      &kp N8      &kp N7
                &kp N0          &kp N3      &kp N2      &kp N1
                &trans           &trans       &trans       &trans      &mt LEFT_SHIFT SPACE

                &to BASE        &kp N9      &kp N8      &kp N7
                &kp N0          &kp N3      &kp N2      &kp N1
                &trans           &trans       &trans       &trans      &mt LEFT_SHIFT SPACE
            >;
        };

        sym_layer {
            bindings = <
                &to BASE        &kp RPAR    &kp COLON   &kp LPAR
                &kp SQT         &kp RBKT    &kp EQUAL   &kp LBKT
                &trans           &trans       &trans       &trans      &trans

                &to BASE        &kp RPAR    &kp COLON   &kp LPAR
                &kp SQT         &kp RBKT    &kp EQUAL   &kp LBKT
                &trans           &trans       &trans       &trans      &trans
            >;
        };

        nav_layer {
            bindings = <
                &to BASE        &kp END     &kp UP      &kp HOME
                &kp DEL         &kp RIGHT   &kp DOWN    &kp LEFT
                &trans           &trans       &trans       &kp BSPC    &kp LEFT_SHIFT

                &to BASE        &kp END     &kp UP      &kp HOME
                &kp DEL         &kp RIGHT   &kp DOWN    &kp LEFT
                &trans           &trans       &trans       &kp BSPC    &kp LEFT_SHIFT
            >;
        };

        mouse_layer {
            bindings = <
                &to BASE        &msc SCRL_DOWN &mmv MOVE_UP   &msc SCRL_UP
                &trans           &mmv MOVE_RIGHT &mmv MOVE_DOWN &mmv MOVE_LEFT
                &trans           &trans          &mkp MCLK      &mkp RCLK     &mkp LCLK

                &to BASE        &msc SCRL_DOWN &mmv MOVE_UP   &msc SCRL_UP
                &trans           &mmv MOVE_RIGHT &mmv MOVE_DOWN &mmv MOVE_LEFT
                &trans           &trans          &mkp MCLK      &mkp RCLK     &mkp LCLK
            >;
        };

        func_layer {
            bindings = <
                &to BASE        &kp F6      &kp F5      &kp F4
                &kp F12         &kp F3      &kp F2      &kp F1
                &trans           &trans       &trans       &lt NUM BSPC &mt LEFT_SHIFT SPACE

                &to BASE        &kp F6      &kp F5      &kp F4
                &kp F12         &kp F3      &kp F2      &kp F1
                &trans           &trans       &trans       &lt NUM BSPC &mt LEFT_SHIFT SPACE
            >;
        };

        sys_layer {
            bindings = <
                &trans          &out OUT_TOG &bt BT_SEL 4 &bt BT_SEL 3
                &trans           &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0
                &trans           &trans        &trans        &bt BT_CLR  &mo MEDIA

                &trans          &out OUT_TOG &bt BT_SEL 4 &bt BT_SEL 3
                &trans           &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0
                &trans           &trans        &trans        &bt BT_CLR  &mo MEDIA
            >;
        };

        media_layer {
            bindings = <
                &trans          &kp C_NEXT  &kp C_PP    &kp C_PREV
                &trans           &kp C_VOL_UP &kp C_MUTE  &kp C_VOL_DN
                &trans           &trans       &trans       &trans       &trans

                &trans          &kp C_NEXT  &kp C_PP    &kp C_PREV
                &trans           &kp C_VOL_UP &kp C_MUTE  &kp C_VOL_DN
                &trans           &trans       &trans       &trans       &trans
            >;
        };
    };
};