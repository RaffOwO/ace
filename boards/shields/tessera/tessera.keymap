/*
 * Tessera split keymap.
 *
 * Global key position order:
 *   Left half:  L0..L12  = positions 0..12
 *   Right half: R0..R12  = positions 13..25
 *
 * No cross-half combos are defined. Each half runs the same local logic.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define BASE 0
#define NUM 1
#define SYM 2
#define NAV 3
#define MOUSE 4
#define FUNC 5
#define SYS 6
#define MEDIA 7
#define MOUSE_FAST 8

#define FAST_MOVE_UP MOVE_Y(-1800)
#define FAST_MOVE_DOWN MOVE_Y(1800)
#define FAST_MOVE_LEFT MOVE_X(-1800)
#define FAST_MOVE_RIGHT MOVE_X(1800)
#define FAST_SCRL_UP MOVE_Y(30)
#define FAST_SCRL_DOWN MOVE_Y(-30)

#define L0 0
#define L1 1
#define L2 2
#define L3 3
#define L4 4
#define L5 5
#define L6 6
#define L7 7
#define L8 8
#define L9 9
#define L10 10
#define L11 11
#define L12 12
#define R0 13
#define R1 14
#define R2 15
#define R3 16
#define R4 17
#define R5 18
#define R6 19
#define R7 20
#define R8 21
#define R9 22
#define R10 23
#define R11 24
#define R12 25

/ {
    behaviors {
        skp: superkey {
            compatible = "zmk,behavior-superkey";
            display-name = "SuperKey";
            #binding-cells = <1>;
            tapping-term-ms = <150>;
            double-tap-ms = <250>;
            release-after-ms = <3000>;
        };

        fmmv: fast_mouse_move {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <120>;
            acceleration-exponent = <1>;
        };

        fmsc: fast_mouse_scroll {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_HWHEEL>;
            y-input-code = <INPUT_REL_WHEEL>;
            time-to-max-speed-ms = <120>;
            acceleration-exponent = <0>;
        };
    };

    fmmv_input_listener: fmmv_input_listener {
        compatible = "zmk,input-listener";
        device = <&fmmv>;
    };

    fmsc_input_listener: fmsc_input_listener {
        compatible = "zmk,input-listener";
        device = <&fmsc>;
    };
};

/ {
    #define COMBO_GLOBAL(NAME, BINDINGS, KEYPOS) \
    combo_##NAME { \
        timeout-ms = <20>; \
        bindings = <BINDINGS>; \
        key-positions = <KEYPOS>; \
    };

    #define COMBO_ACCESS(NAME, BINDINGS, KEYPOS) \
    combo_##NAME { \
        timeout-ms = <20>; \
        bindings = <BINDINGS>; \
        key-positions = <KEYPOS>; \
    };

    #define COMBO_LAYER(NAME, BINDINGS, KEYPOS, LAYERS) \
    combo_##NAME { \
        timeout-ms = <20>; \
        bindings = <BINDINGS>; \
        key-positions = <KEYPOS>; \
        layers = <LAYERS>; \
    };

    combos {
        compatible = "zmk,combos";

        COMBO_GLOBAL(tab_l, &kp TAB, L3 L2 L1)
        COMBO_GLOBAL(tab_r, &kp TAB, R3 R2 R1)
        COMBO_GLOBAL(enter_l, &kp ENTER, L7 L6 L5)
        COMBO_GLOBAL(enter_r, &kp ENTER, R7 R6 R5)
        COMBO_GLOBAL(esc_l, &kp ESC, L6 L5 L4)
        COMBO_GLOBAL(esc_r, &kp ESC, R6 R5 R4)

        COMBO_ACCESS(access_sym_l, &mo SYM, L11 L12)
        COMBO_ACCESS(access_sym_r, &mo SYM, R11 R12)
        COMBO_ACCESS(access_nav_l, &to NAV, L0 L12)
        COMBO_ACCESS(access_nav_r, &to NAV, R0 R12)
        COMBO_ACCESS(access_mouse_l, &to MOUSE, L0 L11)
        COMBO_ACCESS(access_mouse_r, &to MOUSE, R0 R11)
        COMBO_ACCESS(access_func_l, &to FUNC, L0 L10)
        COMBO_ACCESS(access_func_r, &to FUNC, R0 R10)

        COMBO_LAYER(alpha_d_l, &kp D, L3 L7, BASE)
        COMBO_LAYER(alpha_d_r, &kp D, R3 R7, BASE)
        COMBO_LAYER(alpha_l_l, &kp L, L2 L6, BASE)
        COMBO_LAYER(alpha_l_r, &kp L, R2 R6, BASE)
        COMBO_LAYER(alpha_b_l, &kp B, L1 L5, BASE)
        COMBO_LAYER(alpha_b_r, &kp B, R1 R5, BASE)
        COMBO_LAYER(alpha_r_l, &kp R, L2 L3, BASE)
        COMBO_LAYER(alpha_r_r, &kp R, R2 R3, BASE)
        COMBO_LAYER(alpha_c_l, &kp C, L1 L2, BASE)
        COMBO_LAYER(alpha_c_r, &kp C, R1 R2, BASE)
        COMBO_LAYER(alpha_h_l, &kp H, L6 L7, BASE)
        COMBO_LAYER(alpha_h_r, &kp H, R6 R7, BASE)
        COMBO_LAYER(alpha_u_l, &kp U, L5 L6, BASE)
        COMBO_LAYER(alpha_u_r, &kp U, R5 R6, BASE)
        COMBO_LAYER(alpha_m_l, &kp M, L1 L3, BASE)
        COMBO_LAYER(alpha_m_r, &kp M, R1 R3, BASE)
        COMBO_LAYER(alpha_w_l, &kp W, L5 L7, BASE)
        COMBO_LAYER(alpha_w_r, &kp W, R5 R7, BASE)
        COMBO_LAYER(alpha_p_l, &kp P, L4 L5, BASE)
        COMBO_LAYER(alpha_p_r, &kp P, R4 R5, BASE)
        COMBO_LAYER(alpha_y_l, &kp Y, L2 L7, BASE)
        COMBO_LAYER(alpha_y_r, &kp Y, R2 R7, BASE)
        COMBO_LAYER(alpha_g_l, &kp G, L2 L5, BASE)
        COMBO_LAYER(alpha_g_r, &kp G, R2 R5, BASE)
        COMBO_LAYER(alpha_f_l, &kp F, L3 L6, BASE)
        COMBO_LAYER(alpha_f_r, &kp F, R3 R6, BASE)
        COMBO_LAYER(alpha_v_l, &kp V, L1 L4, BASE)
        COMBO_LAYER(alpha_v_r, &kp V, R1 R4, BASE)
        COMBO_LAYER(alpha_k_l, &kp K, L3 L5, BASE)
        COMBO_LAYER(alpha_k_r, &kp K, R3 R5, BASE)
        COMBO_LAYER(alpha_z_l, &kp Z, L3 L4, BASE)
        COMBO_LAYER(alpha_z_r, &kp Z, R3 R4, BASE)
        COMBO_LAYER(alpha_x_l, &kp X, L1 L7, BASE)
        COMBO_LAYER(alpha_x_r, &kp X, R1 R7, BASE)
        COMBO_LAYER(alpha_j_l, &kp J, L4 L7, BASE)
        COMBO_LAYER(alpha_j_r, &kp J, R4 R7, BASE)
        COMBO_LAYER(alpha_q_l, &kp Q, L1 L6, BASE)
        COMBO_LAYER(alpha_q_r, &kp Q, R1 R6, BASE)

        COMBO_LAYER(num_4_l, &kp N4, L3 L7, NUM)
        COMBO_LAYER(num_4_r, &kp N4, R3 R7, NUM)
        COMBO_LAYER(num_5_l, &kp N5, L2 L6, NUM)
        COMBO_LAYER(num_5_r, &kp N5, R2 R6, NUM)
        COMBO_LAYER(num_6_l, &kp N6, L1 L5, NUM)
        COMBO_LAYER(num_6_r, &kp N6, R1 R5, NUM)
        COMBO_LAYER(num_plus_l, &kp PLUS, L2 L3, NUM)
        COMBO_LAYER(num_plus_r, &kp PLUS, R2 R3, NUM)
        COMBO_LAYER(num_minus_l, &kp MINUS, L1 L2, NUM)
        COMBO_LAYER(num_minus_r, &kp MINUS, R1 R2, NUM)
        COMBO_LAYER(num_star_l, &kp STAR, L6 L7, NUM)
        COMBO_LAYER(num_star_r, &kp STAR, R6 R7, NUM)
        COMBO_LAYER(num_slash_l, &kp FSLH, L5 L6, NUM)
        COMBO_LAYER(num_slash_r, &kp FSLH, R5 R6, NUM)
        COMBO_LAYER(num_comma_l, &kp COMMA, L1 L4, NUM)
        COMBO_LAYER(num_comma_r, &kp COMMA, R1 R4, NUM)
        COMBO_LAYER(num_dot_l, &kp DOT, L4 L5, NUM)
        COMBO_LAYER(num_dot_r, &kp DOT, R4 R5, NUM)
        COMBO_LAYER(num_semi_l, &kp SEMI, L3 L4, NUM)
        COMBO_LAYER(num_semi_r, &kp SEMI, R3 R4, NUM)
        COMBO_LAYER(num_colon_l, &kp COLON, L4 L7, NUM)
        COMBO_LAYER(num_colon_r, &kp COLON, R4 R7, NUM)
        COMBO_LAYER(num_equal_l, &kp EQUAL, L1 L3, NUM)
        COMBO_LAYER(num_equal_r, &kp EQUAL, R1 R3, NUM)
        COMBO_LAYER(num_percent_l, &kp PRCNT, L2 L7, NUM)
        COMBO_LAYER(num_percent_r, &kp PRCNT, R2 R7, NUM)
        COMBO_LAYER(num_caret_l, &kp CARET, L3 L6, NUM)
        COMBO_LAYER(num_caret_r, &kp CARET, R3 R6, NUM)
        COMBO_LAYER(num_lt_l, &kp LT, L2 L5, NUM)
        COMBO_LAYER(num_lt_r, &kp LT, R2 R5, NUM)
        COMBO_LAYER(num_gt_l, &kp GT, L1 L6, NUM)
        COMBO_LAYER(num_gt_r, &kp GT, R1 R6, NUM)
        COMBO_LAYER(num_lpar_l, &kp LPAR, L1 L7, NUM)
        COMBO_LAYER(num_lpar_r, &kp LPAR, R1 R7, NUM)
        COMBO_LAYER(num_rpar_l, &kp RPAR, L3 L5, NUM)
        COMBO_LAYER(num_rpar_r, &kp RPAR, R3 R5, NUM)

        COMBO_LAYER(sym_semi_l, &kp SEMI, L2 L6, SYM)
        COMBO_LAYER(sym_semi_r, &kp SEMI, R2 R6, SYM)
        COMBO_LAYER(sym_slash_l, &kp FSLH, L2 L7, SYM)
        COMBO_LAYER(sym_slash_r, &kp FSLH, R2 R7, SYM)
        COMBO_LAYER(sym_bslash_l, &kp BSLH, L3 L6, SYM)
        COMBO_LAYER(sym_bslash_r, &kp BSLH, R3 R6, SYM)
        COMBO_LAYER(sym_lt_l, &kp LT, L2 L3, SYM)
        COMBO_LAYER(sym_lt_r, &kp LT, R2 R3, SYM)
        COMBO_LAYER(sym_gt_l, &kp GT, L1 L2, SYM)
        COMBO_LAYER(sym_gt_r, &kp GT, R1 R2, SYM)
        COMBO_LAYER(sym_lbrace_l, &kp LBRC, L6 L7, SYM)
        COMBO_LAYER(sym_lbrace_r, &kp LBRC, R6 R7, SYM)
        COMBO_LAYER(sym_rbrace_l, &kp RBRC, L5 L6, SYM)
        COMBO_LAYER(sym_rbrace_r, &kp RBRC, R5 R6, SYM)
        COMBO_LAYER(sym_dquote_l, &kp DQT, L4 L5, SYM)
        COMBO_LAYER(sym_dquote_r, &kp DQT, R4 R5, SYM)
        COMBO_LAYER(sym_grave_l, &kp GRAVE, L1 L4, SYM)
        COMBO_LAYER(sym_grave_r, &kp GRAVE, R1 R4, SYM)
        COMBO_LAYER(sym_under_l, &kp UNDER, L5 L7, SYM)
        COMBO_LAYER(sym_under_r, &kp UNDER, R5 R7, SYM)
        COMBO_LAYER(sym_pipe_l, &kp PIPE, L3 L7, SYM)
        COMBO_LAYER(sym_pipe_r, &kp PIPE, R3 R7, SYM)
        COMBO_LAYER(sym_amp_l, &kp AMPS, L2 L5, SYM)
        COMBO_LAYER(sym_amp_r, &kp AMPS, R2 R5, SYM)
        COMBO_LAYER(sym_at_l, &kp AT, L1 L5, SYM)
        COMBO_LAYER(sym_at_r, &kp AT, R1 R5, SYM)
        COMBO_LAYER(sym_qmark_l, &kp QMARK, L4 L7, SYM)
        COMBO_LAYER(sym_qmark_r, &kp QMARK, R4 R7, SYM)
        COMBO_LAYER(sym_exclaim_l, &kp EXCL, L3 L4, SYM)
        COMBO_LAYER(sym_exclaim_r, &kp EXCL, R3 R4, SYM)
        COMBO_LAYER(sym_hash_l, &kp HASH, L1 L7, SYM)
        COMBO_LAYER(sym_hash_r, &kp HASH, R1 R7, SYM)
        COMBO_LAYER(sym_dollar_l, &kp DLLR, L3 L5, SYM)
        COMBO_LAYER(sym_dollar_r, &kp DLLR, R3 R5, SYM)
        COMBO_LAYER(sym_tilde_l, &kp TILDE, L1 L3, SYM)
        COMBO_LAYER(sym_tilde_r, &kp TILDE, R1 R3, SYM)

        COMBO_LAYER(func_f7_l, &kp F7, L3 L7, FUNC)
        COMBO_LAYER(func_f7_r, &kp F7, R3 R7, FUNC)
        COMBO_LAYER(func_f8_l, &kp F8, L2 L6, FUNC)
        COMBO_LAYER(func_f8_r, &kp F8, R2 R6, FUNC)
        COMBO_LAYER(func_f9_l, &kp F9, L1 L5, FUNC)
        COMBO_LAYER(func_f9_r, &kp F9, R1 R5, FUNC)
        COMBO_LAYER(func_f10_l, &kp F10, L2 L3, FUNC)
        COMBO_LAYER(func_f10_r, &kp F10, R2 R3, FUNC)
        COMBO_LAYER(func_f11_l, &kp F11, L1 L2, FUNC)
        COMBO_LAYER(func_f11_r, &kp F11, R1 R2, FUNC)

        COMBO_LAYER(mouse_btn4_l, &mkp MB4, L4 L1, MOUSE)
        COMBO_LAYER(mouse_btn4_r, &mkp MB4, R4 R1, MOUSE)
        COMBO_LAYER(mouse_btn5_l, &mkp MB5, L4 L3, MOUSE)
        COMBO_LAYER(mouse_btn5_r, &mkp MB5, R4 R3, MOUSE)
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &mo SYS         &kp S       &kp N       &kp I
                &kp A           &kp O       &kp T       &kp E
                &skp LEFT_CONTROL &skp LEFT_GUI &skp LEFT_ALT &lt NUM BSPC &mt LEFT_SHIFT SPACE

                &mo SYS         &kp S       &kp N       &kp I
                &kp A           &kp O       &kp T       &kp E
                &skp LEFT_CONTROL &skp LEFT_GUI &skp LEFT_ALT &lt NUM BSPC &mt LEFT_SHIFT SPACE
            >;
        };

        num_layer {
            bindings = <
                &to BASE        &kp N9      &kp N8      &kp N7
                &kp N0          &kp N3      &kp N2      &kp N1
                &skp LEFT_CONTROL &skp LEFT_GUI &skp LEFT_ALT &trans      &mt LEFT_SHIFT SPACE

                &to BASE        &kp N9      &kp N8      &kp N7
                &kp N0          &kp N3      &kp N2      &kp N1
                &skp LEFT_CONTROL &skp LEFT_GUI &skp LEFT_ALT &trans      &mt LEFT_SHIFT SPACE
            >;
        };

        sym_layer {
            bindings = <
                &to BASE        &kp RPAR    &kp COLON   &kp LPAR
                &kp SQT         &kp RBKT    &kp EQUAL   &kp LBKT
                &skp LEFT_CONTROL &skp LEFT_GUI &skp LEFT_ALT &trans      &trans

                &to BASE        &kp RPAR    &kp COLON   &kp LPAR
                &kp SQT         &kp RBKT    &kp EQUAL   &kp LBKT
                &skp LEFT_CONTROL &skp LEFT_GUI &skp LEFT_ALT &trans      &trans
            >;
        };

        nav_layer {
            bindings = <
                &to BASE        &kp END     &kp UP      &kp HOME
                &kp DEL         &kp RIGHT   &kp DOWN    &kp LEFT
                &skp LEFT_CONTROL &skp LEFT_GUI &skp LEFT_ALT &kp BSPC    &kp LEFT_SHIFT

                &to BASE        &kp END     &kp UP      &kp HOME
                &kp DEL         &kp RIGHT   &kp DOWN    &kp LEFT
                &skp LEFT_CONTROL &skp LEFT_GUI &skp LEFT_ALT &kp BSPC    &kp LEFT_SHIFT
            >;
        };

        mouse_layer {
            bindings = <
                &to BASE        &msc SCRL_DOWN &mmv MOVE_UP   &msc SCRL_UP
                &mo MOUSE_FAST  &mmv MOVE_RIGHT &mmv MOVE_DOWN &mmv MOVE_LEFT
                &skp LEFT_CONTROL &skp LEFT_GUI    &mkp MCLK      &mkp RCLK     &mkp LCLK

                &to BASE        &msc SCRL_DOWN &mmv MOVE_UP   &msc SCRL_UP
                &mo MOUSE_FAST  &mmv MOVE_RIGHT &mmv MOVE_DOWN &mmv MOVE_LEFT
                &skp LEFT_CONTROL &skp LEFT_GUI    &mkp MCLK      &mkp RCLK     &mkp LCLK
            >;
        };

        func_layer {
            bindings = <
                &to BASE        &kp F6      &kp F5      &kp F4
                &kp F12         &kp F3      &kp F2      &kp F1
                &skp LEFT_CONTROL &skp LEFT_GUI &skp LEFT_ALT &lt NUM BSPC &mt LEFT_SHIFT SPACE

                &to BASE        &kp F6      &kp F5      &kp F4
                &kp F12         &kp F3      &kp F2      &kp F1
                &skp LEFT_CONTROL &skp LEFT_GUI &skp LEFT_ALT &lt NUM BSPC &mt LEFT_SHIFT SPACE
            >;
        };

        sys_layer {
            bindings = <
                &trans          &out OUT_TOG &bt BT_SEL 4 &bt BT_SEL 3
                &none           &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0
                &none           &none        &none        &bt BT_CLR  &mo MEDIA

                &trans          &out OUT_TOG &bt BT_SEL 4 &bt BT_SEL 3
                &none           &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0
                &none           &none        &none        &bt BT_CLR  &mo MEDIA
            >;
        };

        media_layer {
            bindings = <
                &trans          &kp C_NEXT  &kp C_PP    &kp C_PREV
                &none           &kp C_VOL_UP &kp C_MUTE  &kp C_VOL_DN
                &none           &none       &none       &none       &trans

                &trans          &kp C_NEXT  &kp C_PP    &kp C_PREV
                &none           &kp C_VOL_UP &kp C_MUTE  &kp C_VOL_DN
                &none           &none       &none       &none       &trans
            >;
        };

        mouse_fast_layer {
            bindings = <
                &to BASE        &fmsc FAST_SCRL_DOWN &fmmv FAST_MOVE_UP   &fmsc FAST_SCRL_UP
                &trans          &fmmv FAST_MOVE_RIGHT &fmmv FAST_MOVE_DOWN &fmmv FAST_MOVE_LEFT
                &skp LEFT_CONTROL &skp LEFT_GUI       &mkp MCLK           &mkp RCLK          &mkp LCLK

                &to BASE        &fmsc FAST_SCRL_DOWN &fmmv FAST_MOVE_UP   &fmsc FAST_SCRL_UP
                &trans          &fmmv FAST_MOVE_RIGHT &fmmv FAST_MOVE_DOWN &fmmv FAST_MOVE_LEFT
                &skp LEFT_CONTROL &skp LEFT_GUI       &mkp MCLK           &mkp RCLK          &mkp LCLK
            >;
        };
    };
};
