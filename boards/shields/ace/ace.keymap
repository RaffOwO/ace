/*
 * ACE standalone 13-key controller keymap.
 *
 * Left build uses positions L0..L12.
 * Right build keeps col-offset and uses positions R0..R12.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYM 1
#define NAV 2
#define MOUSE 3
#define FUNC 4
#define NUM 5
#define SYS 6

#define COMBO_TIMEOUT_TYPING 33
#define COMBO_TIMEOUT_ACCESS 66
#define L0 0
#define L1 1
#define L2 2
#define L3 3
#define L4 4
#define L5 5
#define L6 6
#define L7 7
#define L8 8
#define L9 9
#define L10 10
#define L11 11
#define L12 12

#define R0 13
#define R1 14
#define R2 15
#define R3 16
#define R4 17
#define R5 18
#define R6 19
#define R7 20
#define R8 21
#define R9 22
#define R10 23
#define R11 24
#define R12 25

/ {
    behaviors {
        k0_sys: k0_sys {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&to>;
        };
    };

    #define TCOMBO(NAME, BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
    combo_l_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_TYPING>; \
        bindings = <BINDINGS>; \
        key-positions = <LEFT_KEYPOS>; \
        slow-release; \
    }; \
    combo_r_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_TYPING>; \
        bindings = <BINDINGS>; \
        key-positions = <RIGHT_KEYPOS>; \
        slow-release; \
    };

    #define TCOMBO_ACCESS(NAME, BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
    combo_l_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_ACCESS>; \
        bindings = <BINDINGS>; \
        key-positions = <LEFT_KEYPOS>; \
        slow-release; \
    }; \
    combo_r_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_ACCESS>; \
        bindings = <BINDINGS>; \
        key-positions = <RIGHT_KEYPOS>; \
        slow-release; \
    };

    #define TCOMBO_LAYER(NAME, BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS, LAYER) \
    combo_l_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_TYPING>; \
        bindings = <BINDINGS>; \
        key-positions = <LEFT_KEYPOS>; \
        layers = <LAYER>; \
        slow-release; \
    }; \
    combo_r_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_TYPING>; \
        bindings = <BINDINGS>; \
        key-positions = <RIGHT_KEYPOS>; \
        layers = <LAYER>; \
        slow-release; \
    };

    combos {
        compatible = "zmk,combos";

        TCOMBO(tab, &kp TAB, L3 L2 L1, R3 R2 R1)
        TCOMBO(enter, &kp ENTER, L7 L6 L5, R7 R6 R5)
        TCOMBO(esc, &kp ESC, L6 L5 L4, R6 R5 R4)

        TCOMBO_ACCESS(access_sym, &to SYM, L11 L0, R11 R0)
        TCOMBO_ACCESS(access_nav, &to NAV, L12 L0, R12 R0)
        TCOMBO_ACCESS(access_mouse, &to MOUSE, L10 L0, R10 R0)
        TCOMBO_ACCESS(access_func, &to FUNC, L9 L0, R9 R0)

        TCOMBO_LAYER(alpha_d, &kp D, L1 L4, R3 R7, BASE)
        TCOMBO_LAYER(alpha_l, &kp L, L2 L5, R2 R6, BASE)
        TCOMBO_LAYER(alpha_b, &kp B, L3 L6, R1 R5, BASE)
        TCOMBO_LAYER(alpha_r, &kp R, L1 L2, R2 R3, BASE)
        TCOMBO_LAYER(alpha_c, &kp C, L2 L3, R1 R2, BASE)
        TCOMBO_LAYER(alpha_h, &kp H, L4 L5, R6 R7, BASE)
        TCOMBO_LAYER(alpha_u, &kp U, L5 L6, R5 R6, BASE)
        TCOMBO_LAYER(alpha_w, &kp W, L1 L3, R3 R1, BASE)
        TCOMBO_LAYER(alpha_m, &kp M, L4 L6, R7 R5, BASE)
        TCOMBO_LAYER(alpha_z, &kp Z, L3 L4, R1 R7, BASE)
        TCOMBO_LAYER(alpha_x, &kp X, L1 L6, R3 R5, BASE)
        TCOMBO_LAYER(alpha_p, &kp P, L4 L2, R7 R2, BASE)
        TCOMBO_LAYER(alpha_g, &kp G, L6 L2, R5 R2, BASE)
        TCOMBO_LAYER(alpha_f, &kp F, L5 L1, R6 R3, BASE)
        TCOMBO_LAYER(alpha_y, &kp Y, L7 L6, R4 R5, BASE)
        TCOMBO_LAYER(alpha_v, &kp V, L5 L3, R6 R1, BASE)
        TCOMBO_LAYER(alpha_q, &kp Q, L7 L1, R4 R3, BASE)
        TCOMBO_LAYER(alpha_j, &kp J, L7 L4, R4 R7, BASE)
        TCOMBO_LAYER(alpha_k, &kp K, L7 L3, R4 R1, BASE)

        TCOMBO_LAYER(num_4, &kp N4, L3 L7, R3 R7, NUM)
        TCOMBO_LAYER(num_5, &kp N5, L2 L6, R2 R6, NUM)
        TCOMBO_LAYER(num_6, &kp N6, L1 L5, R1 R5, NUM)
        TCOMBO_LAYER(num_plus, &kp PLUS, L2 L3, R2 R3, NUM)
        TCOMBO_LAYER(num_minus, &kp MINUS, L1 L2, R1 R2, NUM)
        TCOMBO_LAYER(num_star, &kp STAR, L6 L7, R6 R7, NUM)
        TCOMBO_LAYER(num_slash, &kp FSLH, L5 L6, R5 R6, NUM)
        TCOMBO_LAYER(num_comma, &kp COMMA, L4 L3, R4 R3, NUM)
        TCOMBO_LAYER(num_dot, &kp DOT, L4 L5, R4 R5, NUM)
        TCOMBO_LAYER(num_semi, &kp SEMI, L4 L7, R4 R7, NUM)
        TCOMBO_LAYER(num_colon, &kp COLON, L7 L5, R7 R5, NUM)
        TCOMBO_LAYER(num_equal, &kp EQUAL, L1 L3, R1 R3, NUM)
        TCOMBO_LAYER(num_percent, &kp PRCNT, L1 L7, R1 R7, NUM)
        TCOMBO_LAYER(num_caret, &kp CARET, L3 L5, R3 R5, NUM)
        TCOMBO_LAYER(num_lt, &kp LT, L5 L2, R5 R2, NUM)
        TCOMBO_LAYER(num_gt, &kp GT, L1 L6, R1 R6, NUM)
        TCOMBO_LAYER(num_lpar, &kp LPAR, L7 L2, R7 R2, NUM)
        TCOMBO_LAYER(num_rpar, &kp RPAR, L6 L3, R6 R3, NUM)
        TCOMBO_LAYER(num_under, &kp UNDER, L4 L1, R4 R1, NUM)

        TCOMBO_LAYER(sym_semi, &kp SEMI, L2 L6, R2 R6, SYM)
        TCOMBO_LAYER(sym_slash, &kp FSLH, L7 L2, R7 R2, SYM)
        TCOMBO_LAYER(sym_bslash, &kp BSLH, L6 L3, R6 R3, SYM)
        TCOMBO_LAYER(sym_lt, &kp LT, L2 L3, R2 R3, SYM)
        TCOMBO_LAYER(sym_gt, &kp GT, L1 L2, R1 R2, SYM)
        TCOMBO_LAYER(sym_lbrace, &kp LBRC, L6 L7, R6 R7, SYM)
        TCOMBO_LAYER(sym_rbrace, &kp RBRC, L5 L6, R5 R6, SYM)
        TCOMBO_LAYER(sym_dquote, &kp DQT, L4 L5, R4 R5, SYM)
        TCOMBO_LAYER(sym_grave, &kp GRAVE, L4 L1, R4 R1, SYM)
        TCOMBO_LAYER(sym_under, &kp UNDER, L5 L7, R5 R7, SYM)
        TCOMBO_LAYER(sym_minus, &kp MINUS, L3 L1, R3 R1, SYM)
        TCOMBO_LAYER(sym_pipe, &kp PIPE, L3 L7, R3 R7, SYM)
        TCOMBO_LAYER(sym_amp, &kp AMPS, L1 L5, R1 R5, SYM)
        TCOMBO_LAYER(sym_exclaim, &kp EXCL, L1 L7, R1 R7, SYM)
        TCOMBO_LAYER(sym_qmark, &kp QMARK, L3 L5, R3 R5, SYM)
        TCOMBO_LAYER(sym_hash, &kp HASH, L5 L2, R5 R2, SYM)
        TCOMBO_LAYER(sym_at, &kp AT, L1 L6, R1 R6, SYM)
        TCOMBO_LAYER(sym_dollar, &kp DLLR, L3 L4, R3 R4, SYM)

        TCOMBO_LAYER(func_f4, &kp F4, L3 L7, R3 R7, FUNC)
        TCOMBO_LAYER(func_f5, &kp F5, L2 L6, R2 R6, FUNC)
        TCOMBO_LAYER(func_f6, &kp F6, L1 L5, R1 R5, FUNC)
        TCOMBO_LAYER(func_f11, &kp F11, L4 L7, R4 R7, FUNC)
        TCOMBO_LAYER(func_f12, &kp F12, L4 L5, R4 R5, FUNC)
        TCOMBO_LAYER(func_media_prev, &kp C_PREV, L3 L2, R3 R2, FUNC)
        TCOMBO_LAYER(func_media_next, &kp C_NEXT, L2 L1, R2 R1, FUNC)
        TCOMBO_LAYER(func_media_vol_down, &kp C_VOL_DN, L7 L6, R7 R6, FUNC)
        TCOMBO_LAYER(func_media_vol_up, &kp C_VOL_UP, L6 L5, R6 R5, FUNC)
        TCOMBO_LAYER(func_media_mute, &kp C_MUTE, L1 L7, R1 R7, FUNC)

        TCOMBO_LAYER(mouse_btn4, &mkp MB4, L4 L1, R4 R1, MOUSE)
        TCOMBO_LAYER(mouse_btn5, &mkp MB5, L4 L3, R4 R3, MOUSE)
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &k0_sys SYS BASE &kp I       &kp N       &kp S
                &kp E            &kp T       &kp O       &kp A
                &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &lt NUM BSPC &mt LEFT_SHIFT SPACE

                &k0_sys SYS BASE &kp S       &kp N       &kp I
                &kp A            &kp O       &kp T       &kp E
                &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &lt NUM BSPC &mt LEFT_SHIFT SPACE
            >;
        };

        sym_layer {
            bindings = <
                &k0_sys SYS BASE &kp RPAR    &kp COLON   &kp LPAR
                &kp SQT          &kp RBKT    &kp EQUAL   &kp LBKT
                &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &lt NUM BSPC &mt LEFT_SHIFT SPACE

                &k0_sys SYS BASE &kp RPAR    &kp COLON   &kp LPAR
                &kp SQT          &kp RBKT    &kp EQUAL   &kp LBKT
                &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &lt NUM BSPC &mt LEFT_SHIFT SPACE
            >;
        };

        nav_layer {
            bindings = <
                &k0_sys SYS BASE &kp END     &kp UP      &kp HOME
                &kp DEL          &kp LEFT    &kp DOWN    &kp RIGHT
                &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &lt NUM BSPC &kp LEFT_SHIFT

                &k0_sys SYS BASE &kp END     &kp UP      &kp HOME
                &kp DEL          &kp RIGHT   &kp DOWN    &kp LEFT
                &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &lt NUM BSPC &kp LEFT_SHIFT
            >;
        };

        mouse_layer {
            bindings = <
                &k0_sys SYS BASE &msc SCRL_DOWN &mmv MOVE_UP   &msc SCRL_UP
                &none            &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT
                &kp LEFT_CONTROL &kp LEFT_GUI    &mkp MCLK      &mkp RCLK     &mkp LCLK

                &k0_sys SYS BASE &msc SCRL_DOWN &mmv MOVE_UP   &msc SCRL_UP
                &none            &mmv MOVE_RIGHT &mmv MOVE_DOWN &mmv MOVE_LEFT
                &kp LEFT_CONTROL &kp LEFT_GUI    &mkp MCLK      &mkp RCLK     &mkp LCLK
            >;
        };

        func_layer {
            bindings = <
                &k0_sys SYS BASE &kp F9      &kp F8      &kp F7
                &kp F10          &kp F3      &kp F2      &kp F1
                &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &lt NUM BSPC &kp LEFT_SHIFT

                &k0_sys SYS BASE &kp F9      &kp F8      &kp F7
                &kp F10          &kp F3      &kp F2      &kp F1
                &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &lt NUM BSPC &kp LEFT_SHIFT
            >;
        };

        num_layer {
            bindings = <
                &k0_sys SYS BASE &kp N9      &kp N8      &kp N7
                &kp N0           &kp N3      &kp N2      &kp N1
                &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &trans      &mt LEFT_SHIFT SPACE

                &k0_sys SYS BASE &kp N9      &kp N8      &kp N7
                &kp N0           &kp N3      &kp N2      &kp N1
                &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &trans      &mt LEFT_SHIFT SPACE
            >;
        };

        sys_layer {
            bindings = <
                &trans          &out OUT_TOG &bt BT_SEL 4 &bt BT_SEL 3
                &trans          &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0
                &trans          &trans       &studio_unlock &bt BT_CLR  &trans

                &trans          &out OUT_TOG &bt BT_SEL 4 &bt BT_SEL 3
                &trans          &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0
                &trans          &trans       &studio_unlock &bt BT_CLR  &trans
            >;
        };
    };
};
