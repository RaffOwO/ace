/*
 * ACE Taipo-style split keymap.
 *
 * Global key position order:
 *   Left card:  L0..L12  = positions 0..12
 *   Right card: R0..R12  = positions 13..25
 *
 * Each card owns its own virtual layer stack. Shared OS modifiers remain
 * normal HID modifiers, so Ctrl/Alt/GUI/Shift can combine across both cards.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define L_BASE 1
#define R_BASE 2
#define L_SYM 3
#define R_SYM 4
#define L_NAV 5
#define R_NAV 6
#define L_MOUSE 7
#define R_MOUSE 8
#define L_FUNC 9
#define R_FUNC 10
#define L_NUM 11
#define R_NUM 12
#define SYS 13

#define CHORD_TIMEOUT_TYPING 33
#define COMBO_TIMEOUT_TYPING 33
#define COMBO_TIMEOUT_ACCESS 66
#define STICKY_TIMEOUT 3000

#define AC_BASE 0
#define AC_NUM 1
#define AC_SYM 2
#define AC_FUNC 3

#define L0 0
#define L1 1
#define L2 2
#define L3 3
#define L4 4
#define L5 5
#define L6 6
#define L7 7
#define L8 8
#define L9 9
#define L10 10
#define L11 11
#define L12 12

#define R0 13
#define R1 14
#define R2 15
#define R3 16
#define R4 17
#define R5 18
#define R6 19
#define R7 20
#define R8 21
#define R9 22
#define R10 23
#define R11 24
#define R12 25

&sk {
    release-after-ms = <STICKY_TIMEOUT>;
    quick-release;
};

/ {
    behaviors {
        tsl: ace_side_layer {
            compatible = "zmk,behavior-side-layer";
            #binding-cells = <1>;
            left-layers = <L_BASE L_SYM L_NAV L_MOUSE L_FUNC>;
            right-layers = <R_BASE R_SYM R_NAV R_MOUSE R_FUNC>;
        };

        k0_sys: k0_sys {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            bindings = <&mo>, <&tsl>;
        };

        achord: ace_chord {
            compatible = "zmk,behavior-ace-chord";
            #binding-cells = <2>;
            timeout-ms = <CHORD_TIMEOUT_TYPING>;
        };
    };

    #define TCOMBO(NAME, BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
    combo_l_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_TYPING>; \
        bindings = <BINDINGS>; \
        key-positions = <LEFT_KEYPOS>; \
        slow-release; \
    }; \
    combo_r_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_TYPING>; \
        bindings = <BINDINGS>; \
        key-positions = <RIGHT_KEYPOS>; \
        slow-release; \
    };

    #define TCOMBO_SPLIT(NAME, LEFT_BINDING, RIGHT_BINDING, LEFT_KEYPOS, RIGHT_KEYPOS) \
    combo_l_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_ACCESS>; \
        bindings = <LEFT_BINDING>; \
        key-positions = <LEFT_KEYPOS>; \
        slow-release; \
    }; \
    combo_r_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_ACCESS>; \
        bindings = <RIGHT_BINDING>; \
        key-positions = <RIGHT_KEYPOS>; \
        slow-release; \
    };

    #define TCOMBO_SIDE(NAME, BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS, LEFT_LAYER, RIGHT_LAYER) \
    combo_l_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_TYPING>; \
        bindings = <BINDINGS>; \
        key-positions = <LEFT_KEYPOS>; \
        layers = <LEFT_LAYER>; \
        slow-release; \
    }; \
    combo_r_##NAME { \
        timeout-ms = <COMBO_TIMEOUT_TYPING>; \
        bindings = <BINDINGS>; \
        key-positions = <RIGHT_KEYPOS>; \
        layers = <RIGHT_LAYER>; \
        slow-release; \
    };

    combos {
        compatible = "zmk,combos";

        TCOMBO(tab, &kp TAB, L3 L2 L1, R3 R2 R1)
        TCOMBO(enter, &kp ENTER, L7 L6 L5, R7 R6 R5)
        TCOMBO(esc, &kp ESC, L6 L5 L4, R6 R5 R4)

        TCOMBO_SPLIT(access_sym, &tsl L_SYM, &tsl R_SYM, L11 L0, R11 R0)
        TCOMBO_SPLIT(access_nav, &tsl L_NAV, &tsl R_NAV, L12 L0, R12 R0)
        TCOMBO_SPLIT(access_mouse, &tsl L_MOUSE, &tsl R_MOUSE, L10 L0, R10 R0)
        TCOMBO_SPLIT(access_func, &tsl L_FUNC, &tsl R_FUNC, L9 L0, R9 R0)

        TCOMBO_SIDE(mouse_btn4, &mkp MB4, L4 L1, R4 R1, L_MOUSE, R_MOUSE)
        TCOMBO_SIDE(mouse_btn5, &mkp MB5, L4 L3, R4 R3, L_MOUSE, R_MOUSE)
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &k0_sys SYS L_BASE &achord AC_BASE 1 &achord AC_BASE 2 &achord AC_BASE 3
                &achord AC_BASE 4  &achord AC_BASE 5 &achord AC_BASE 6 &achord AC_BASE 7
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &lt L_NUM BSPC &mt LEFT_SHIFT SPACE

                &k0_sys SYS R_BASE &achord AC_BASE 1 &achord AC_BASE 2 &achord AC_BASE 3
                &achord AC_BASE 4  &achord AC_BASE 5 &achord AC_BASE 6 &achord AC_BASE 7
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &lt R_NUM BSPC &mt LEFT_SHIFT SPACE
            >;
        };

        l_base_layer {
            bindings = <
                &k0_sys SYS L_BASE &achord AC_BASE 1 &achord AC_BASE 2 &achord AC_BASE 3
                &achord AC_BASE 4  &achord AC_BASE 5 &achord AC_BASE 6 &achord AC_BASE 7
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &lt L_NUM BSPC &mt LEFT_SHIFT SPACE

                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans      &trans
            >;
        };

        r_base_layer {
            bindings = <
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans      &trans

                &k0_sys SYS R_BASE &achord AC_BASE 1 &achord AC_BASE 2 &achord AC_BASE 3
                &achord AC_BASE 4  &achord AC_BASE 5 &achord AC_BASE 6 &achord AC_BASE 7
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &lt R_NUM BSPC &mt LEFT_SHIFT SPACE
            >;
        };

        l_sym_layer {
            bindings = <
                &k0_sys SYS L_BASE &achord AC_SYM 1 &achord AC_SYM 2 &achord AC_SYM 3
                &achord AC_SYM 4   &achord AC_SYM 5 &achord AC_SYM 6 &achord AC_SYM 7
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &lt L_NUM BSPC &mt LEFT_SHIFT SPACE

                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans      &trans
            >;
        };

        r_sym_layer {
            bindings = <
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans      &trans

                &k0_sys SYS R_BASE &achord AC_SYM 1 &achord AC_SYM 2 &achord AC_SYM 3
                &achord AC_SYM 4   &achord AC_SYM 5 &achord AC_SYM 6 &achord AC_SYM 7
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &lt R_NUM BSPC &mt LEFT_SHIFT SPACE
            >;
        };

        l_nav_layer {
            bindings = <
                &k0_sys SYS L_BASE &kp END     &kp UP      &kp HOME
                &kp DEL            &kp LEFT    &kp DOWN    &kp RIGHT
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &lt L_NUM BSPC &kp LEFT_SHIFT

                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans      &trans
            >;
        };

        r_nav_layer {
            bindings = <
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans      &trans

                &k0_sys SYS R_BASE &kp END     &kp UP      &kp HOME
                &kp DEL            &kp RIGHT   &kp DOWN    &kp LEFT
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &lt R_NUM BSPC &kp LEFT_SHIFT
            >;
        };

        l_mouse_layer {
            bindings = <
                &k0_sys SYS L_BASE &msc SCRL_DOWN &mmv MOVE_UP   &msc SCRL_UP
                &none              &mmv MOVE_LEFT  &mmv MOVE_DOWN &mmv MOVE_RIGHT
                &sk LEFT_CONTROL   &sk LEFT_GUI    &mkp MCLK      &mkp RCLK     &mkp LCLK

                &trans             &trans          &trans         &trans
                &trans             &trans          &trans         &trans
                &trans             &trans          &trans         &trans        &trans
            >;
        };

        r_mouse_layer {
            bindings = <
                &trans             &trans          &trans         &trans
                &trans             &trans          &trans         &trans
                &trans             &trans          &trans         &trans        &trans

                &k0_sys SYS R_BASE &msc SCRL_DOWN &mmv MOVE_UP   &msc SCRL_UP
                &none              &mmv MOVE_RIGHT &mmv MOVE_DOWN &mmv MOVE_LEFT
                &sk LEFT_CONTROL   &sk LEFT_GUI    &mkp MCLK      &mkp RCLK     &mkp LCLK
            >;
        };

        l_func_layer {
            bindings = <
                &k0_sys SYS L_BASE &achord AC_FUNC 1 &achord AC_FUNC 2 &achord AC_FUNC 3
                &achord AC_FUNC 4  &achord AC_FUNC 5 &achord AC_FUNC 6 &achord AC_FUNC 7
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &lt L_NUM BSPC &kp LEFT_SHIFT

                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans      &trans
            >;
        };

        r_func_layer {
            bindings = <
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans      &trans

                &k0_sys SYS R_BASE &achord AC_FUNC 1 &achord AC_FUNC 2 &achord AC_FUNC 3
                &achord AC_FUNC 4  &achord AC_FUNC 5 &achord AC_FUNC 6 &achord AC_FUNC 7
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &lt R_NUM BSPC &kp LEFT_SHIFT
            >;
        };

        l_num_layer {
            bindings = <
                &k0_sys SYS L_BASE &achord AC_NUM 1 &achord AC_NUM 2 &achord AC_NUM 3
                &achord AC_NUM 4   &achord AC_NUM 5 &achord AC_NUM 6 &achord AC_NUM 7
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &trans      &mt LEFT_SHIFT SPACE

                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans      &trans
            >;
        };

        r_num_layer {
            bindings = <
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans
                &trans             &trans      &trans      &trans      &trans

                &k0_sys SYS R_BASE &achord AC_NUM 1 &achord AC_NUM 2 &achord AC_NUM 3
                &achord AC_NUM 4   &achord AC_NUM 5 &achord AC_NUM 6 &achord AC_NUM 7
                &sk LEFT_CONTROL   &sk LEFT_GUI &sk LEFT_ALT &trans      &mt LEFT_SHIFT SPACE
            >;
        };

        sys_layer {
            bindings = <
                &trans          &out OUT_TOG &bt BT_SEL 4 &bt BT_SEL 3
                &trans          &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0
                &trans          &trans       &studio_unlock &bt BT_CLR  &trans

                &trans          &out OUT_TOG &bt BT_SEL 4 &bt BT_SEL 3
                &trans          &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0
                &trans          &trans       &studio_unlock &bt BT_CLR  &trans
            >;
        };

    };
};
