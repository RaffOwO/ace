#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define K00 0
#define K01 1
#define K02 2
#define K03 3
#define K04 4
#define K05 5
#define K06 6
#define K07 7
#define K08 8
#define K09 9
#define K10 10
#define K11 11
#define K12 12

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q      &kp W      &kp E      &kp R
                &kp A      &kp S      &kp D      &kp F
                &kp Z      &kp X      &kp C      &kp V      &kp SPACE
            >;
        };
    };
};
